{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trace_flow data",
  "description": "`data` field of the `trace_flow` envelope (\u00a710.2). Paths are root-to-leaf chains ranked by contract-boundary hops desc, min_confidence desc, length desc, leaf id. `gaps` lists where the chain stops and why.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "from": {
      "type": "object"
    },
    "direction": {
      "type": "string",
      "enum": [
        "downstream",
        "upstream"
      ]
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "min_confidence": {
            "type": "number"
          },
          "boundary_hops": {
            "type": "integer"
          },
          "hops": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "node_type": {
                  "type": "string"
                },
                "repo": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "edge_type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The edge that led to this hop; null for the seed."
                },
                "provenance": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "engine_fact": {
                  "type": "boolean",
                  "description": "True when the edge is a static/confirmed engine fact; false for heuristic, runtime or provenance-less edges. The seed is always true."
                }
              },
              "required": [
                "id",
                "name",
                "node_type",
                "edge_type",
                "engine_fact"
              ]
            }
          }
        },
        "required": [
          "min_confidence",
          "boundary_hops",
          "hops"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "no_handler",
              "no_consumers",
              "unbound_consumer",
              "unlinked_call_site",
              "no_table_access",
              "no_data_sink",
              "dangling_edge"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "node",
          "name",
          "kind",
          "reason"
        ]
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "truncation_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "depth",
          "cap",
          "node_budget"
        ]
      }
    },
    "nodes_visited": {
      "type": "integer"
    },
    "scope": {
      "type": "object"
    }
  },
  "required": [
    "from",
    "direction",
    "seeds",
    "paths",
    "gaps",
    "truncated",
    "truncation_reasons",
    "nodes_visited",
    "scope"
  ]
}
