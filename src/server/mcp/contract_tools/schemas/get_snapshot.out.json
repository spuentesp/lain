{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "get_snapshot output",
  "description": "Output for `get_snapshot`. Same shape as `prepare_snapshot`.",
  "type": "object",
  "required": ["snapshot", "state", "repos"],
  "properties": {
    "snapshot": { "type": "string" },
    "state": {
      "type": "string",
      "enum": ["pending", "indexing", "ready", "failed"]
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "state"],
        "properties": {
          "repo": { "type": "string" },
          "state": {
            "type": "string",
            "enum": ["cached", "queued", "indexing", "failed", "excluded"]
          },
          "commit": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    },
    "created_unix": { "type": "integer" },
    "last_access_unix": { "type": "integer" }
  }
}
