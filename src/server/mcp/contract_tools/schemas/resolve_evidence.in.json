{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "resolve_evidence input",
  "description": "Input for `resolve_evidence`.`refs` accepts GlobalIds or EvidenceRef texts (`<repo>@<sha>:<path>:<line>`).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "snapshot": { "type": "string" },
    "refs": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 200
    },
    "context_lines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    }
  },
  "required": ["snapshot", "refs"]
}
