{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "apply_contract_context data",
  "description": "`data` field of the `apply_contract_context` envelope.",
  "type": "object",
  "properties": {
    "applied": { "type": "boolean", "description": "True only when the declaration was written and the re-joined index serves it." },
    "dry_run": { "type": "boolean" },
    "config_path": { "type": "string" },
    "added": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "service": { "type": "string" }, "key": { "type": "string" } }
      }
    },
    "yaml": { "type": "string", "description": "The full repos.yaml that would be written (dry run)." },
    "backup": { "type": "string", "description": "The .bak file holding the previous content (applied)." },
    "note": { "type": "string" }
  }
}
