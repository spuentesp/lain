{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["count", "legacy", "occupancy"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/definitions/graph_node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/definitions/graph_edge"}
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodes", "edges"],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {"$ref": "#/definitions/graph_node"}
          },
          "edges": {
            "type": "array",
            "items": {"$ref": "#/definitions/graph_edge"}
          }
        }
      }
    },
    "count": {"type": "integer", "minimum": 0},
    "legacy": {"type": "boolean"},
    "meta": {
      "type": "object",
      "required": ["exec_us", "nodes_visited"],
      "properties": {
        "exec_us": {"type": "integer", "minimum": 0},
        "nodes_visited": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "matched_before_limit": {"type": "integer", "minimum": 0},
        "next_cursor": {"type": "string"}
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "nodes", "count"],
        "properties": {
          "key": {"type": "string"},
          "nodes": {
            "type": "array",
            "items": {"$ref": "#/definitions/graph_node"}
          },
          "count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "occupancy": {
      "type": "object",
      "required": ["active_agents"],
      "properties": {
        "active_agents": {"type": "array", "items": {"type": "object"}}
      }
    }
  },
  "definitions": {
    "graph_node": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "name": {"type": "string"},
        "label": {"type": "string"},
        "path": {"type": "string"},
        "line_start": {"type": "integer", "minimum": 0},
        "line_end": {"type": "integer", "minimum": 0},
        "commit": {"type": "string"},
        "repo_id": {"type": "string"}
      }
    },
    "graph_edge": {
      "type": "object",
      "required": ["id", "type", "from", "to"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "provenance": {"$ref": "#/definitions/edge_provenance"},
        "confidence": {"type": "number"},
        "site": {"$ref": "#/definitions/source_site"},
        "detail": {"$ref": "#/definitions/edge_detail"}
      }
    },
    "edge_provenance": {
      "oneOf": [
        {
          "type": "object",
          "required": ["Static"],
          "properties": {
            "Static": {
              "type": "object",
              "required": ["source"],
              "properties": {
                "source": {
                  "type": "string",
                  "enum": ["TreeSitter", "Lsp", "Regex"]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["Heuristic"],
          "properties": {
            "Heuristic": {
              "type": "object",
              "required": ["detector", "confidence"],
              "properties": {
                "detector": {"type": "string"},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["Runtime"],
          "properties": {
            "Runtime": {
              "type": "object",
              "required": ["trace_id", "last_seen_unix"],
              "properties": {
                "trace_id": {"type": "string"},
                "last_seen_unix": {"type": "integer"}
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["Confirmed"],
          "properties": {
            "Confirmed": {
              "type": "object",
              "required": ["source"],
              "properties": {
                "source": {"type": "string"}
              }
            }
          }
        }
      ]
    },
    "source_site": {
      "type": "object",
      "required": ["path", "line"],
      "properties": {
        "path": {"type": "string"},
        "line": {"type": "integer", "minimum": 0}
      }
    },
    "edge_detail": {
      "type": "object",
      "required": ["route_match", "stripped_prefix"],
      "properties": {
        "route_match": {
          "type": ["string", "null"],
          "enum": ["Exact", "Pattern", "PrefixStripped", null]
        },
        "stripped_prefix": {"type": ["string", "null"]}
      }
    }
  }
}
