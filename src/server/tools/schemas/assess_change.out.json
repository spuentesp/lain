{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "target",
    "risk",
    "direct_dependents",
    "transitive_dependents",
    "untested_dependents",
    "co_change_partners",
    "counts"
  ],
  "properties": {
    "target": {
      "type": "object"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "low* \u2014 heuristic-only (see ~ N heuristic caller(s) below)",
        "medium",
        "high"
      ]
    },
    "direct_dependents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "transitive_dependents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "heuristic_dependents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "untested_dependents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "co_change_partners": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "direct",
        "transitive"
      ],
      "properties": {
        "direct": {
          "type": "integer",
          "minimum": 0
        },
        "transitive": {
          "type": "integer",
          "minimum": 0
        },
        "heuristic": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "answer_scope": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "unresolved_name",
        "ambiguous_target",
        "dynamic_target",
        "stale_or_unindexed",
        "truncated"
      ],
      "description": "Why the answer cannot be read as complete, or null when it can. A null on an empty result is a confirmed absence (the index is current and nothing calls it)."
    }
  }
}
