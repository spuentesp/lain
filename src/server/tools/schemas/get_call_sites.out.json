{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["target", "sites", "count", "ambiguous"],
  "properties": {
    "target": {"type": "object"},
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caller", "lines", "exact"],
        "properties": {
          "caller": {"type": "object"},
          "lines": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "exact": {"type": "boolean"}
        }
      }
    },
    "count": {"type": "integer", "minimum": 0},
    "ambiguous": {"type": "boolean"}
  }
}
